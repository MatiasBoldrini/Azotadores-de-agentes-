{
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/agent/operation.mjs": {"maxDuration": 20}
  },
  "git": {
    "deploymentEnabled": false
  },
  "headers": [{"source":"/data/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}]
}
